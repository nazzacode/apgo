#!/usr/bin/env bash
# apgo-stats [days] · most-used leader paths (from apgo-usage.log). Default: all time.
log=${APGO_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/apgo}/apgo-usage.log
[ -f "$log" ] || { echo "no usage yet: $log"; exit 0; }
since=${1:+$(date -d "-$1 days" +%Y-%m-%dT%H:%M:%S)}
awk -F'\t' -v s="$since" '$1 >= s { n[$2 "\t" $3]++ } END { for (k in n) print n[k] "\t" k }' "$log" | sort -rn | column -t -s $'\t'
